  <!-- capture ring pose (virtual chain replacing the Stewart platform closure) -->
  <joint name="ring_x" type="prismatic">
    <parent link="nds_base" />
    <child link="nds_ring_virtual_ring_x" />
    <origin xyz="0.53829 -0.085257 0.5204" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.15" upper="0.15" effort="1000" velocity="1" />
  </joint>
  <link name="nds_ring_virtual_ring_y">
    <inertial>
      <mass value="0.001" />
      <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="ring_y" type="prismatic">
    <parent link="nds_ring_virtual_ring_x" />
    <child link="nds_ring_virtual_ring_y" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.15" upper="0.15" effort="1000" velocity="1" />
  </joint>
  <link name="nds_ring_virtual_ring_z">
    <inertial>
