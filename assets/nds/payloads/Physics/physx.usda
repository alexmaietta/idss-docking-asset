#usda 1.0
(
    customLayerData = {
        string creator = "idss pipeline (scripts/package.py)"
    }
    defaultPrim = "nds"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
