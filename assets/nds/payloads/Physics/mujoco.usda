#usda 1.0
(
    customLayerData = {
        string creator = "idss pipeline (scripts/package.py)"
    }
    defaultPrim = "nds"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "nds"
{
    over "Physics"
    {
        over "hook_c_00" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 1000
        }

        def MjcActuator "hook_c_00_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -50000000, -40000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 40000
            uniform double mjc:forceRange:min = -40000
            uniform double[] mjc:gainPrm = [50000000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </nds/Physics/hook_c_00>
        }

        over "hook_a_00" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
