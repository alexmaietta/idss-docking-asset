    def Xform "col_hook_a_11" (
        prepend references = @./geometries.usd@</Geometries/col_hook_a_11>
    )
    {
        over "col_hook_a_11" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "NewtonSDFCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Instances/col_hook_a_11/PhysicsMaterials/titanium> (
                bindMaterialAs = "weakerThanDescendants"
            )
            float newton:contactGap = 0.0015
            float newton:contactMargin = 0
            uniform float newton:sdfNarrowBandInner = -0.004
            uniform float newton:sdfNarrowBandOuter = 0.004
            uniform float newton:sdfTargetVoxelSize = 0.0006
            uniform token physics:approximation = "none"
            uniform token purpose = "guide"
        }

        def Scope "PhysicsMaterials"
        {
            def Material "titanium" (
                prepend references = @./physics_materials.usda@</PhysicsMaterials/titanium>
            )
            {
            }
        }
    }

    def Xform "col_hook_a_11_hydro" (
        prepend references = </Instances/col_hook_a_11>
    )
    {
        over "col_hook_a_11"
        {
            bool newton:hydroelasticEnabled = 1
            float newton:hydroelasticStiffness = 10000000000
        }
    }

    def Xform "col_hook_p_00" (
        prepend references = @./geometries.usd@</Geometries/col_hook_p_00>
    )
    {
        over "col_hook_p_00" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "NewtonSDFCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
