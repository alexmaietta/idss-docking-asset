#usda 1.0
(
    customLayerData = {
        string creator = "idss pipeline (scripts/package.py)"
    }
    defaultPrim = "ida"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "ida"
{
    def Scope "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </ida/Looks/steel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5599926, 0.5599926, 0.56998545)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.30060238
                token outputs:surface
            }
        }

        def Material "titanium_dfl"
        {
            token outputs:surface.connect = </ida/Looks/titanium_dfl/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
