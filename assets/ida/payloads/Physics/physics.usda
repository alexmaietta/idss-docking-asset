    def "Physics"
    {
        def PhysicsPrismaticJoint "hook_c_00" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 40000
            float drive:linear:physics:maxForce = 40000
            float drive:linear:physics:stiffness = 50000000
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            custom string idss:role = "hook_pull1"
            float newton:armature = 1000
            float newton:damping = 0
            uniform token physics:axis = "X"
            rel physics:body0 = </ida/Geometry/ida_base>
            rel physics:body1 = </ida/Geometry/ida_base/hook_c_00>
            point3f physics:localPos0 = (0.6332566, 0.20022124, 0.6168)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, -0, 0.70710677, 0)
            quatf physics:localRot1 = (0.70710677, -0, 0.70710677, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.008
            float state:linear:physics:position = 0
            float state:linear:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "hook_a_00" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1.7453293
            float drive:angular:physics:maxForce = 600
            float drive:angular:physics:stiffness = 349.06586
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom string idss:role = "hook_gang1"
            float newton:armature = 0.5
            float newton:damping = 0
            uniform token physics:axis = "X"
            rel physics:body0 = </ida/Geometry/ida_base/hook_c_00>
            rel physics:body1 = </ida/Geometry/ida_base/hook_c_00/hook_a_00>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.1305262, 0, 0, -0.9914449)
            quatf physics:localRot1 = (0.1305262, 0, 0, -0.9914449)
            float physics:lowerLimit = 0
