#usda 1.0
(
    customLayerData = {
        string creator = "idss pipeline (scripts/package.py)"
    }
    defaultPrim = "ida"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ida" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "International Docking Adapter (passive IDSS)"
    token isaac:license = "Other"
    string isaac:namespace = "ida"
    prepend rel isaac:physics:robotJoints = [
        </ida/Physics/hook_c_00>,
        </ida/Physics/hook_a_00>,
